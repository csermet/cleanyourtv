<?xml version="1.0" encoding="utf-8"?>
<!-- Wallpaper picker: the focused picture fills the screen as a live preview; small cards along the bottom. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <ImageView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/picker_scrim" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingTop="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wallpaper"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:fontFamily="@font/outfit_light" />

        <TextView
            android:id="@+id/pickerHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/wallpaper_picker_hint"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/outfit_regular" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/thumbs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="12dp"
        android:paddingBottom="36dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:overScrollMode="never" />
</FrameLayout>
