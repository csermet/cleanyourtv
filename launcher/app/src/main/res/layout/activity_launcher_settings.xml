<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher settings over today's wallpaper, dimmed; one column of frosted rows in sections. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0A0A0F">

    <ImageView
        android:id="@+id/settingsBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/settings_scrim" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="600dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="72dp"
            android:paddingTop="40dp"
            android:paddingBottom="48dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/launcher_settings"
                android:textColor="#FFFFFFFF"
                android:textSize="34sp"
                android:fontFamily="@font/outfit_light" />

            <TextView android:id="@+id/wallpaperHeader" style="@style/SettingsHeader" android:text="@string/section_wallpaper" />
            <TextView android:id="@+id/wallpaperChoice" style="@style/SettingsRow" />
            <TextView android:id="@+id/wallpaperHint" style="@style/SettingsHint" android:text="@string/wallpaper_hint" />

            <TextView style="@style/SettingsHeader" android:text="@string/section_live_background" />
            <TextView style="@style/SettingsLabel" android:text="@string/live_background_label" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <TextView android:id="@+id/livePicture" style="@style/SettingsSegment" android:text="@string/live_picture" />
                <TextView android:id="@+id/liveVideo" style="@style/SettingsSegment" android:text="@string/live_video" />
                <TextView android:id="@+id/livePictureEffect" style="@style/SettingsSegment" android:text="@string/live_picture_effect" />
                <TextView android:id="@+id/liveVideoEffect" style="@style/SettingsSegment" android:text="@string/live_video_effect" />
            </LinearLayout>
            <TextView android:id="@+id/liveVideoChoice" style="@style/SettingsRow" android:layout_marginTop="12dp" />
            <TextView android:id="@+id/liveEffectLabel" style="@style/SettingsLabel"
                android:layout_marginTop="16dp" android:text="@string/live_effect_label" />
            <LinearLayout
                android:id="@+id/liveEffectRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <TextView android:id="@+id/liveSparks" style="@style/SettingsSegment" android:text="@string/live_sparks" />
                <TextView android:id="@+id/liveDust" style="@style/SettingsSegment" android:text="@string/live_dust" />
                <TextView android:id="@+id/liveBoth" style="@style/SettingsSegment" android:text="@string/live_both" />
            </LinearLayout>
            <TextView android:id="@+id/liveHint" style="@style/SettingsHint" />

            <TextView android:id="@+id/plexHeader" style="@style/SettingsHeader" android:text="@string/section_plex" />
            <TextView android:id="@+id/plexChoice" style="@style/SettingsRow" />
            <TextView android:id="@+id/plexHint" style="@style/SettingsHint" android:text="@string/plex_hint" />

            <TextView style="@style/SettingsHeader" android:text="@string/section_apps" />
            <TextView android:id="@+id/showHiddenChoice" style="@style/SettingsRow" />
            <TextView android:id="@+id/resetOrderChoice" style="@style/SettingsRow"
                android:layout_marginTop="10dp" android:text="@string/reset_order" />
            <TextView style="@style/SettingsHint" android:text="@string/tile_menu_hint" />

            <TextView style="@style/SettingsHeader" android:text="@string/section_home" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:text="@string/columns_label"
                android:textColor="#E6FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/outfit_regular" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
                <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
                <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
                <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="4dp"
                android:text="@string/rows_below_dock_label"
                android:textColor="#E6FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/outfit_regular" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <TextView android:id="@+id/rows0" style="@style/SettingsColumnChoice" android:text="0" />
                <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:text="1" />
                <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:text="2" />
                <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:text="3" />
            </LinearLayout>
            <TextView android:id="@+id/animationsChoice" style="@style/SettingsRow" android:layout_marginTop="12dp" />
            <TextView android:id="@+id/advancedChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
            <TextView style="@style/SettingsHint" android:text="@string/advanced_effects_warning" />
            <TextView android:id="@+id/followThemeChoice" style="@style/SettingsRow"
                android:layout_marginTop="12dp" android:text="@string/follow_theme" />
            <TextView style="@style/SettingsHint" android:text="@string/follow_theme_hint" />

            <TextView style="@style/SettingsHeader" android:text="@string/section_system" />
            <TextView android:id="@+id/defaultHomeChoice" style="@style/SettingsRow" android:text="@string/home_settings" />
            <TextView style="@style/SettingsHint" android:text="@string/home_settings_help" />
            <TextView android:id="@+id/tvSettingsChoice" style="@style/SettingsRow"
                android:layout_marginTop="12dp" android:text="@string/tv_settings" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
