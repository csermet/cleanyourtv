<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher settings rows: frosted on the dimmed wallpaper, solid white when focused (tvOS style),
     an accent outline for the current choice. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F2FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#339B6FF0" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="#FF9B6FF0" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1FFFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
